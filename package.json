{
  "name": "task-management",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"next dev\" \"npm run start:dev --workspace=merlot-api\"",
    "dev:web": "next dev",
    "dev:api": "npm run start:dev --workspace=merlot-api",
    "build": "next build",
    "build:api": "npm run build --workspace=merlot-api",
    "build:all": "next build && npm run build --workspace=merlot-api",
    "start": "next start",
    "start:api": "npm run start --workspace=merlot-api",
    "lint": "eslint",
    "db:seed": "tsx scripts/seed.ts",
    "db:admin": "tsx scripts/ensure-admin.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.116.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.43.0",
    "nanoid": "^6.0.1",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "5.9.3"
  },
  "overrides": {
    "typescript": "5.9.3",
    "@nestjs/schematics": "11.0.9"
  }
}
