{
  "name": "merlot-api",
  "version": "0.1.0",
  "private": true,
  "description": "Merlot API (Fastify)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsc -p tsconfig.build.json && npx --prefix ../.. concurrently -k -n tsc,api -c green,magenta \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --enable-source-maps --watch dist/main.js\"",
    "start:prod": "node dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.5",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.5",
    "@nestjs/platform-fastify": "^11.2.5",
    "@types/node": "^22.20.3",
    "@upstash/redis": "^1.38.4",
    "fastify": "^5.12.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "5.9.3"
  }
}
