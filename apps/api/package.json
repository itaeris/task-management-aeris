{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "node compile.cjs",
    "start": "node dist/main.js",
    "start:dev": "node compile.cjs && npx --prefix ../.. concurrently -k -n tsc,api -c green,magenta \"node compile.cjs --watch --preserveWatchOutput\" \"node --enable-source-maps --watch dist/main.js\"",
    "start:prod": "node dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.5",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.5",
    "@nestjs/platform-express": "^11.2.5",
    "@upstash/redis": "^1.38.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.3"
  }
}
